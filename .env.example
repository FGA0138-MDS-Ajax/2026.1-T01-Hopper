# Supabase
# URL do projeto e chave pública (anon) — usadas no client padrão (lib/supabaseClient.ts)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave service-role — usada APENAS no servidor (lib/supabaseAdmin.ts), ignora RLS.
# Necessária para os crons lerem dados sem usuário logado. NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (envio de e-mail — RF07)
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Hopper <no-reply@seudominio.com>")
EMAIL_FROM=

# Cron
# Segredo compartilhado: os crons só executam com header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
